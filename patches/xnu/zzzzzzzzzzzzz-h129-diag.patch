 native_iokit_log(const char *op, const char *cls, const char *detail, int ok)
 {
-	if (strcmp(op, "match") == 0) {
-		if (native_iokit_match_logs++ >= 24) return;
-	} else if (native_iokit_open_logs++ >= 24) {
-		return;
-	}
 	char comm[17] = {};
 	proc_selfname(comm, sizeof(comm));
+	/* H129: backboardd and SpringBoard are never capped, so the log answers
+	 * "which class does backboardd ask for" instead of a boot flag. */
