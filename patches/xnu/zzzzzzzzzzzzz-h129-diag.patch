+			return;
+		}
+	}
 	IOLog("NATIVE_IOKIT: op=%s comm=%s cls=%s d=%s ok=%d flags=%x\n",
 	    op, comm, cls ? cls : "-", detail ? detail : "-", ok, native_boot_flags);
 }
