diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -4462,6 +4462,16 @@
 	OSString * process = OSDynamicCast(OSString, service->getProperty("NativeSandboxGrantProcess"));
 	char name[17] = {};
 	if (!process) {
+		/* H200: the A540 accelerator is published more than once; an instance without the property must
+		 * not block the render server, so fall back to the class name for backboardd only. */
+		proc_selfname(name, sizeof(name));
+		IOService * svc = service;
+		if (svc && svc->getMetaClass() && 0 == strcmp(name, "backboardd") &&
+		    0 == strcmp(svc->getMetaClass()->getClassName(), "AGXAccelerator")) {
+			IOLog("NATIVE_DISPLAY_OPEN: service=%s process=%s grant=class match=1\n",
+			    svc->getMetaClass()->getClassName(), name);
+			return true;
+		}
 		return false;
 	}
 	proc_selfname(name, sizeof(name));
