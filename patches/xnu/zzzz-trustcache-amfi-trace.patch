+#if CONFIG_MACF
+/*
+ * H96 bring-up diagnostic only.  Disabled unless the boot argument is present.
+ *
+ * AMFI selector 0x5f is _check_cdhash_in_trustcache().  The original AMFI
+ * binary rejects the request before it reaches the XNU trust-cache query when
+ * the caller lacks com.apple.private.amfi.can-check-trust-cache.  This trace
+ * records the caller identity, its code-signing state and the requested
+ * cdhash so the rejection can be attributed without changing policy.
+ */
+static int native_amfi_syscall_trace = -1;
+static unsigned int native_amfi_tc_budget;
+static uint32_t native_amfi_seen_calls;
+
+static boolean_t
+native_amfi_syscall_trace_enabled(void)
+{
+	if (native_amfi_syscall_trace < 0) {
+		int value = 0;
+
+		if (!PE_parse_boot_argn("native-trace-amfi-syscall", &value,
+		    sizeof(value))) {
+			value = 0;
+		}
+		native_amfi_syscall_trace = value;
+	}
+	return native_amfi_syscall_trace != 0;
+}
+
+static void
+native_trace_amfi_syscall(proc_t p, const char *target, int call,
+    user_addr_t arg)
+{
+	struct cs_blob *blob;
+	uint8_t cdhash[20] = { 0 };
+	uint64_t low = 0;
+	uint64_t high = 0;
+	int copied = 0;
+
+	if (!native_amfi_syscall_trace_enabled() ||
+	    call < 0x5a || call > 0x66) {
+		return;
+	}
+
+	/* Keep the first of each selector, and a bounded trace of 0x5f. */
+	if (call == 0x5f) {
+		if (native_amfi_tc_budget++ >= 100000) {
+			return;
+		}
+	} else {
+		uint32_t bit = 1U << (call - 0x5a);
+
+		if (native_amfi_seen_calls & bit) {
+			return;
+		}
+		native_amfi_seen_calls |= bit;
+	}
+
+	blob = csproc_get_blob(p);
+	if (call == 0x5f && arg != 0 &&
+	    copyin(arg, cdhash, sizeof(cdhash)) == 0) {
+		memcpy(&low, cdhash, sizeof(low));
+		memcpy(&high, cdhash + sizeof(low), sizeof(high));
+		copied = 1;
+	}
+
+	printf("NATIVE_AMFI_SYSCALL: pid=%d comm=%s target=%s call=%d "
+	    "arg=0x%llx csflags=0x%llx blob=%p platform=%d "
+	    "cdhash=%016llx%016llx cdhash_valid=%d\n",
+	    proc_getpid(p), p->p_comm, target, call,
+	    (unsigned long long)arg,
+	    (unsigned long long)proc_getcsflags(p), blob,
+	    blob != NULL ? csblob_get_platform_binary(blob) : -1,
+	    (unsigned long long)low, (unsigned long long)high, copied);
+}
+#endif /* CONFIG_MACF */
+
