+#if CONFIG_MACF
+/*
+ * H96 bring-up diagnostic only.  Disabled unless the boot argument is present.
+ * A rejected AMFI selector 0x5f never reaches this function; therefore a
+ * repeated AMFI rejection with no NATIVE_TC_QUERY line proves the loop is in
+ * the caller-authorization gate, not in a trust-cache lookup miss.
+ */
+static int native_trace_tc_query = -1;
+static unsigned int native_trace_tc_query_budget;
+
+static void
+native_trace_trust_cache_query(TCQueryType_t query_type,
+    const uint8_t cdhash[kTCEntryHashSize], kern_return_t result)
+{
+	uint32_t words[5];
+	proc_t p = current_proc();
+	int value = 0;
+
+	if (native_trace_tc_query < 0) {
+		if (!PE_parse_boot_argn("native-trace-trust-cache", &value,
+		    sizeof(value))) {
+			value = 0;
+		}
+		native_trace_tc_query = value;
+	}
+	if (native_trace_tc_query == 0 ||
+	    native_trace_tc_query_budget++ >= 4096) {
+		return;
+	}
+
+	memcpy(words, cdhash, sizeof(words));
+	printf("NATIVE_TC_QUERY: pid=%d comm=%s type=%u "
+	    "cdhash=%08x%08x%08x%08x%08x ret=%d\n",
+	    p != NULL ? proc_getpid(p) : -1,
+	    p != NULL ? p->p_comm : "kernel",
+	    query_type, words[0], words[1], words[2], words[3], words[4],
+	    result);
+}
+#endif /* CONFIG_MACF */
