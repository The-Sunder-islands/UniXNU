 /*
+ * H103 diagnostic only: record selected process exits. This does not alter
+ * exit status, signals, launchd behavior or any verification path.
+ */
+static void
+native_trace_process_exit(proc_t p, int rv, struct os_reason *reason)
+{
+	const char *comm = p->p_comm;
+	uint32_t ns = 0;
+	uint64_t code = 0;
+
+	if (strcmp(comm, "cryptexd") != 0 && strcmp(comm, "eligibilityd") != 0 &&
+	    strcmp(comm, "launchd") != 0 && strcmp(comm, "xpcproxy") != 0 &&
+	    strcmp(comm, "driverkitd") != 0 && strcmp(comm, "backboardd") != 0) {
+		return;
+	}
+	if (reason == OS_REASON_NULL) {
+		reason = p->p_exit_reason;
+	}
+	if (reason != OS_REASON_NULL) {
+		ns = reason->osr_namespace;
+		code = reason->osr_code;
+	}
+	printf("NATIVE_EXIT: pid=%d ppid=%d comm=%s status=0x%x ns=%u code=0x%llx\n",
+	    proc_getpid(p), p->p_ppid, comm, rv, ns, (unsigned long long)code);
+}
