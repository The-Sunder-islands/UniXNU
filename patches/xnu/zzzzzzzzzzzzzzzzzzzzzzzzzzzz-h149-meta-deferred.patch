diff --git a/libkern/c++/OSMetaClass.cpp b/libkern/c++/OSMetaClass.cpp
--- a/libkern/c++/OSMetaClass.cpp
+++ b/libkern/c++/OSMetaClass.cpp
@@ -1487,15 +1487,21 @@
 /* H148: a stray registry serialization must not take the machine down.
  * The old body was panic("OSMetaClass::serialize(): Obsoleted"), and a boot
  * path on this port reaches it; log which class (bounded) and skip it. */
-static unsigned gNativeMetaSerializeLogs;
+/* H149: this runs with preemption disabled (registry/matching locks), so it
+ * must not print.  Record the count and the first class name; the UFS
+ * heartbeat prints them from thread context. */
+extern "C" volatile unsigned native_meta_serialize_count;
+extern "C" volatile const char *native_meta_serialize_class;
+volatile unsigned native_meta_serialize_count;
+volatile const char *native_meta_serialize_class;
 
 bool
 OSMetaClass::serialize(__unused OSSerialize * s) const
 {
-        if (gNativeMetaSerializeLogs < 8) {
-                gNativeMetaSerializeLogs++;
-                printf("NATIVE_META: serialize skipped for %s\n", getClassName());
+        if (native_meta_serialize_count == 0) {
+                native_meta_serialize_class = getClassName();
         }
+        native_meta_serialize_count++;
         return false;
 }
 
