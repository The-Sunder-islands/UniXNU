+#if defined(XNU_OWNER_PREBOOT_LAYOUT) && XNU_OWNER_PREBOOT_LAYOUT
+extern volatile int native_bindfs_boot_mount;
+volatile int native_preboot_overlay_stage = 0;
+volatile int native_preboot_overlay_status = -1;
+
+/*
+ * The OS root has /System/Cryptexes/OS -> ../../private/preboot/Cryptexes/OS,
+ * but no Preboot volume is present in the current userdata. The Data seed
+ * carries /private/var/preboot (cryptex1/current and Cryptexes/OS) so a
+ * read-only union bindfs gives launchd the native Preboot paths before the
+ * SystemOS volume is mounted at /private/preboot/Cryptexes/OS.
+ */
+static int
+native_preboot_overlay_prepare(proc_t p, user_addr_t scratch)
+{
+	const char *source = "/private/var/preboot";
+	const char *point = "/private/preboot";
+	vnode_t probe = NULLVP;
+	struct mount_args request = {.type = scratch, .path = scratch + 0x40,
+	    .flags = MNT_RDONLY | MNT_UNION, .data = scratch + 0x100};
+	int32_t result = 0;
+	int error;
+
+	native_preboot_overlay_stage = 1;
+	error = vnode_lookup(source, 0, &probe, vfs_context_current());
+	if (error) goto done;
+	vnode_put(probe);
+	probe = NULLVP;
+
+	native_preboot_overlay_stage = 2;
+	if ((error = copyout("bindfs", request.type, 7)) ||
+	    (error = copyout(point, request.path, strlen(point) + 1)) ||
+	    (error = copyout(source, request.data, strlen(source) + 1))) goto done;
+
+	native_preboot_overlay_stage = 3;
+	native_bindfs_boot_mount = 1;
+	error = mount(p, &request, &result);
+	native_bindfs_boot_mount = 0;
+	if (error) goto done;
+
+	native_preboot_overlay_stage = 4;
+	error = vnode_lookup("/private/preboot/Cryptexes/OS", 0, &probe, vfs_context_current());
+	if (!error) {
+		vnode_put(probe);
+		probe = NULLVP;
+		native_preboot_overlay_stage = 5;
+	}
+done:
+	if (probe) vnode_put(probe);
+	native_preboot_overlay_status = error;
+	printf("NATIVE_PREBOOT: status=%d stage=%d\n", error, native_preboot_overlay_stage);
+	return error;
+}
